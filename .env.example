# ---------------------------------------------------------------------------
# Fátima — Pastelería Artesanal
# Copiá este archivo como .env.local para desarrollo, o cargá estas variables
# en Vercel → Settings → Environment Variables para producción.
# ---------------------------------------------------------------------------

# URL pública del sitio. Se usa en los metadatos, el sitemap y los datos
# estructurados. Sin barra final.
NEXT_PUBLIC_SITE_URL=https://fatima-pasteleria.vercel.app

# Contraseña del panel de administración (/admin).
# Si no se define, se usa la del repositorio, que es pública. DEFINILA.
ADMIN_PASSWORD=

# Clave para firmar la cookie de sesión del panel. Cualquier cadena larga y
# aleatoria. Cambiarla cierra todas las sesiones abiertas.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Persistencia del catálogo (opcional pero recomendado en producción)
#
# Sin esto, en Vercel los cambios del panel viven sólo en memoria y se pierden
# al reiniciarse el servidor. Con cualquier Redis por REST —Upstash directo o
# el que crea el Marketplace de Vercel— los cambios quedan guardados.
#
# El proyecto acepta los dos juegos de nombres:
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# KV_REST_API_URL=
# KV_REST_API_TOKEN=
