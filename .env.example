# ---------------------------------------------------------------------------
# Fátima — Pastelería Artesanal
# Copiá este archivo como .env.local para desarrollo, o cargá estas variables
# en Vercel → Settings → Environment Variables para producción.
# ---------------------------------------------------------------------------

# URL pública del sitio. Se usa en los metadatos, el sitemap y los datos
# estructurados. Sin barra final.
NEXT_PUBLIC_SITE_URL=https://fatima-pasteleria.vercel.app

# Contraseña del panel de administración (/admin). OBLIGATORIA.
# No hay valor por defecto en el código: sin esta variable el panel no abre
# para nadie y la pantalla de login explica cómo configurarlo.
ADMIN_PASSWORD=

# Clave para firmar la cookie de sesión del panel. Cualquier cadena larga y
# aleatoria. Si no se define, se deriva de la contraseña: funciona, pero
# cambiar la contraseña cierra todas las sesiones abiertas.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Almacenamiento: catálogo y fotos
#
# Vercel Blob guarda el catálogo y recibe las fotos que se suben desde el
# panel. La variable la inyecta Vercel sola al conectar un Blob store al
# proyecto (Storage → Connect Store → Blob): no hace falta escribirla a mano.
# Para desarrollo local se baja con `vercel env pull .env.local`.
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# Alternativa al Blob para el catálogo: cualquier Redis por REST. Si están
# definidas, tienen prioridad. Las fotos siguen necesitando el Blob.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---------------------------------------------------------------------------
# Sincronización con Instagram (opcional)
#
# Lee las publicaciones nuevas de la cuenta y propone una ficha de producto.
# Nada se publica solo: todo espera aprobación en el panel.
# Ver README → "Sincronizar con Instagram".
# ---------------------------------------------------------------------------

# Cuenta a leer. Por defecto, la de lib/site.ts.
INSTAGRAM_USERNAME=faticastro001

# Proveedor: apify | rapidapi. Si se omite, se usa el primero configurado.
INSTAGRAM_PROVIDER=apify

# --- Opción A: Apify (USD 5 de crédito por mes, sin tarjeta) ---
APIFY_TOKEN=
# APIFY_ACTOR_ID=apify~instagram-scraper

# --- Opción B: RapidAPI (el free tier depende de la API que elijas) ---
# En RAPIDAPI_PATH, {username} se reemplaza por la cuenta.
# RAPIDAPI_KEY=
# RAPIDAPI_HOST=instagram-scraper-api2.p.rapidapi.com
# RAPIDAPI_PATH=/v1.2/posts?username_or_id_or_url={username}

# Clave de Google AI Studio. Free tier: ~1.500 llamadas por día.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Protege /api/cron/instagram. Vercel manda este valor como Bearer.
CRON_SECRET=
