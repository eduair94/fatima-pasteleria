      {
        "selector": "JSXOpeningElement[name.name='LeadTimeNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|hours|icon|plain|className|style|key|ref|className|style|children)$/]",
        "message": "<LeadTimeNote> doesn't accept that prop. Declared props: children, hours, icon, plain, className, style."
